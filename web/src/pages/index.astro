---
/**
 * One page, in order.
 *
 * What changed in moving off the single React tree is where the work happens.
 * Astro renders every one of these components to HTML at build time; a client
 * directive is what asks for the JavaScript as well. So Limits and Colophon
 * carry no directive and ship no script, which is correct because neither has
 * ever done anything but print numbers that were already fixed at build time.
 *
 * The quiz loads eagerly because it is the first screen and the button has to
 * work the moment it is seen. Everything below it waits until it is scrolled
 * to, which is also when its data is first needed.
 *
 * The isogloss plate sits directly after the recovery and before the acts that
 * turn inward on the model. Act II ends by claiming that geography survived in
 * the pixels; the plate is what that geography is for, and it is the last
 * place the page is about the country rather than about the method.
 */
import Shell from "../layouts/Shell.astro";
import Quiz from "../sections/Quiz";
import Recovery from "../sections/Recovery";
import Isogloss from "../sections/Isogloss";
import Mistake from "../sections/Mistake";
import Twelve from "../sections/Twelve";
import Limits from "../sections/Limits";
import Colophon from "../sections/Colophon";

const title =
  "Where you learned to talk — recovering American dialect geography";
const description =
  "The Harvard Dialect Survey published its maps but never its data. This recovers the geography from the pixels of those maps, and uses it to guess where you grew up.";
---

<Shell title={title} description={description}>
  <main>
    <Quiz client:load />
    <Recovery client:visible />
    <Isogloss client:visible />
    <Mistake client:visible />
    <Twelve client:visible />
    <Limits />
  </main>
  <Colophon />
</Shell>
